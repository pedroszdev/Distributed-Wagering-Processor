# Copie para .env (o Bun carrega o .env automaticamente).
PORT=3000

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo

# Workers (todos ligados por padrão; os testes desligam no .env.test)
OUTBOX_PUBLISHER_ENABLED=true
SQS_CONSUMER_ENABLED=true
