DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering_test

# Os workers ficam DESLIGADOS nos testes: cada teste chama a "volta" na mão
# (PublishOutboxBatchUseCase.execute / SqsWagerTransactionConsumer.pollOnce /
#  ResolvePendingReferencesUseCase.execute).
OUTBOX_PUBLISHER_ENABLED=false
SQS_CONSUMER_ENABLED=false
PENDING_REFERENCE_WORKER_ENABLED=false

# Filas SÓ dos testes (como o banco wagering_test): os testes esvaziam essas
# filas, então elas nunca podem ser as mesmas do dev. Os testes as criam.
SQS_EVENTS_QUEUE_NAME=wagering-events-test.fifo
SQS_QUEUE_NAME=wager-transactions-test.fifo
SQS_DLQ_NAME=wager-transactions-dlq-test.fifo

# Backoff curto (1s, 2s, 4s...) para os testes de retry/DLQ não levarem minutos.
SQS_RETRY_BASE_DELAY_SECONDS=1
